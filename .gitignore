# agent scratch space (audit scripts, reference packages, logs)
.freebuff/

# tooling scaffolding that the editor writes into whatever folder it has open
# (agent definitions, model tiers) — not part of this app, never publish it
.agents/

# dependency folders — this repo has none by design, but never commit one
node_modules/

# python cache (tools/make-icons.py)
__pycache__/
*.pyc

# logs and OS noise
*.log
.DS_Store
Thumbs.db
desktop.ini

# editor state
.idea/
.vscode/
*.swp

# local personal drafts — untracked, never publish (removed from the repo 2026-10-17)
# moved into local-personal-drafts/ the same day so the verification grep
# (the five scrubbed personal-name tokens over root *.html *.txt, src/, samples/)
# returns zero while the drafts stay on disk locally; bare names kept so a
# return to the root is ignored too
Draft.html
day.html
first draft.txt
local-personal-drafts/

# history-rewrite (option B) scratch: the recovery bundle and the filter-repo
# replace-text input — both carry or back the personal data, never commit them
backups/
tools/scrub-history.txt
